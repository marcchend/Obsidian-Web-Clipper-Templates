{
	"schemaVersion": "0.1.0",
	"name": "GitHub Repositories",
	"behavior": "create",
	"noteContentFormat": "## Notes\n\n",
	"properties": [
		{
			"name": "tags",
			"value": "clippings",
			"type": "multitext"
		},
		{
			"name": "categories",
			"value": "[[Clippings]]",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{selector:#repo-title-component a}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "[[{{meta:name:octolytics-dimension-user_login}}]]",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{selector:[data-testid=\\\\\"latest-commit-details\\\\\"] relative-time}}",
			"type": "date"
		},
		{
			"name": "topics",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "base",
			"value": "[[Clippings.base]]",
			"type": "text"
		},
		{
			"name": "image",
			"value": "{{image}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		}
	],
	"triggers": [
		"/^https:\\/\\/github\\.com\\/[^\\/]+\\/[^\\/]+\\/?$/"
	],
	"noteNameFormat": "{{time|date:YYYY-MM-DD-HHmmss}} {{title}}",
	"path": "Clippings"
}
{
	"schemaVersion": "0.1.0",
	"name": "Goodreads",
	"behavior": "create",
	"noteContentFormat": "\n![BookCover]({{selector:.BookCover__image img?src|first}})\n\n{{selector:.BookPageMetadataSection__description|strip_tags|callout:\"info\",\"Description\",true}}\n\n---\n## Notes\n\n",
	"properties": [
		{
			"name": "aliases",
			"value": "",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "references",
			"type": "multitext"
		},
		{
			"name": "categories",
			"value": "[[Books]]",
			"type": "multitext"
		},
		{
			"name": "title",
			"value": "{{selector:.BookPageTitleSection__title h1}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{selector:.ContributorLink__name|unique|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{selector:p[data-testid='publicationInfo']}}",
			"type": "date"
		},
		{
			"name": "isbn",
			"value": "{{selector:.DescList|split:\\\"ISBN\\\"|slice:1,2|split:\\\" \\\"|first}}",
			"type": "text"
		},
		{
			"name": "genres",
			"value": "{{selector:.BookPageMetadataSection__genres .BookPageMetadataSection__genreButton|wikilink|join}}",
			"type": "multitext"
		},
		{
			"name": "language",
			"value": "{{selector:.DescList|split:\\\"Language\\\"|last}}",
			"type": "text"
		},
		{
			"name": "pages",
			"value": "{{schema:numberOfPages}}",
			"type": "text"
		},
		{
			"name": "scoreGr",
			"value": "{{selector:.RatingStatistics__rating|first|round:2}}",
			"type": "number"
		},
		{
			"name": "rating",
			"value": "",
			"type": "text"
		},
		{
			"name": "topics",
			"value": "",
			"type": "multitext"
		},
		{
			"name": "base",
			"value": "[[Books.base]]",
			"type": "text"
		},
		{
			"name": "image",
			"value": "{{selector:.BookCover__image img?src|first}}",
			"type": "text"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "status",
			"value": "",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.goodreads.com/book/"
	],
	"noteNameFormat": "{{selector:.BookPageTitleSection__title h1}}",
	"path": "References"
}